{
  "name": "urbanrise-site-visits",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first site visit outcome tracker for the Urbanrise pre-screening assignment",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "bun server/server.ts",
    "dev": "bun run build && bun --watch server/server.ts",
