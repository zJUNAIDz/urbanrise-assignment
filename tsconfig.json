{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "types": ["bun"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["client", "server", "tests", "vite.config.ts"]
}
